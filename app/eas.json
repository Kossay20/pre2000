{
    "cli": {
        "version": ">= 14.0.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "channel": "development",
            "node": "20.20.2",
            "ios": {
                "simulator": true
            },
            "android": {
                "buildType": "apk"
            },
            "env": {
                "APP_ENV": "development"
            }
        },
        "preview": {
            "distribution": "internal",
            "channel": "preview",
            "environment": "preview",
            "node": "20.20.2",
            "android": {
                "buildType": "apk"
            },
            "ios": {
                "simulator": false
            },
            "env": {
                "APP_ENV": "preview",
                "SENTRY_DISABLE_AUTO_UPLOAD": "true"
            }
        },
        "production": {
            "autoIncrement": true,
            "distribution": "store",
            "channel": "production",
            "environment": "production",
            "node": "20.20.2",
            "android": {
                "buildType": "app-bundle"
            },
            "ios": {
                "image": "latest"
            },
            "env": {
                "APP_ENV": "production"
            }
        }
    },
    "submit": {
        "production": {
            "ios": {
                "appleId": "$APPLE_ID",
                "ascAppId": "$ASC_APP_ID",
                "appleTeamId": "$APPLE_TEAM_ID"
            },
            "android": {
                "serviceAccountKeyPath": "./google-service-account.json",
                "track": "internal"
            }
        }
    }
}
