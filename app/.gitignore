# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Firebase native config (téléchargés depuis Firebase Console — secrets per-project)
google-services.json
GoogleService-Info.plist
**/google-services.json
**/GoogleService-Info.plist

# Playwright (npm run e2e:web)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
# T6 V1_AUTONOMOUS_RUN audit captures (transient, recréés à chaque run)
/audit-screenshots/
e2e/.auth/

# audit screenshot artifacts (binary, throwaway)
e2e/r3_shots/
e2e/r4_shots/
e2e/r5_shots/
e2e/r7_shots/

# audit screenshot artifacts (binary, throwaway)
e2e/r*_shots/

# E2E audit2 capture artifacts (keep harness scripts + md reports, drop screenshots/DOM)
e2e/audit2/round-*/
e2e/audit2/*_shots/
reports/test-e2e/**/round-*/

# Build artifacts from `expo export` — must never be committed.
dist-*/

# Store screenshots — 54 PNGs (~100 MB), regenerated by `npm run store:shots`.
# Same treatment as audit-screenshots/: the pipeline is the deliverable, not the
# binaries. The feature graphic and icons ARE committed (small and stable).
/store/screenshots/
/store/feature-graphic/_*.html

# Play Console service account used by `eas submit` (submit.production.android).
# It is a private key with upload rights on the whole app — it must never be
# committed. eas.json references it by path; the file is delivered out of band.
google-service-account.json
**/google-service-account.json

# Firestore emulator artefacts (`npm run test:rules`).
firestore-debug.log
ui-debug.log
firebase-debug.log

# E2E web export wired to the Firebase emulators
/dist-e2e*/
/e2e/.stack/
